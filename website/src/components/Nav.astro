---
import { links } from '../data/downloads';
---

<header class="fixed inset-x-0 top-0 z-50">
  <nav
    class="glass mx-auto mt-4 flex max-w-6xl items-center justify-between px-5 py-3"
    style="border-radius: 999px;"
    aria-label="Main"
  >
    <a href="/" class="flex items-center gap-2.5 font-[640]" style="font-family: var(--font-display);">
      <img src="/brand/logomark-color.svg" alt="" width="30" height="30" />
      <span class="text-[1.05rem] tracking-tight">Elysium<span class="text-iridescent">UI</span></span>
    </a>
    <div class="hidden items-center gap-7 text-[0.92rem] text-muted sm:flex">
      <a class="transition-colors hover:text-ink" href="/#features">Features</a>
      <a class="transition-colors hover:text-ink" href="/#designer">Designer</a>
      <a class="transition-colors hover:text-ink" href={links.docs}>Docs</a>
      <a class="transition-colors hover:text-ink" href={links.github} rel="noopener">GitHub</a>
    </div>
    <a href="/download" class="btn-primary !px-5 !py-2 text-[0.9rem]">Download</a>
  </nav>
</header>
