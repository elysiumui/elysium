---
/** Alternating text/visual feature row. `flip` puts the visual on the left. */
interface Props {
  id?: string;
  eyebrow: string;
  title: string;
  body: string;
  bullets?: string[];
  image: string;
  imageAlt: string;
  linkHref?: string;
  linkLabel?: string;
  flip?: boolean;
}
const { id, eyebrow, title, body, bullets = [], image, imageAlt, linkHref, linkLabel, flip = false } = Astro.props;
---

<div {id} class="mx-auto grid max-w-6xl items-center gap-10 px-6 py-16 lg:grid-cols-2 lg:gap-16">
  <div class={`reveal ${flip ? 'lg:order-2' : ''}`}>
    <p class="eyebrow">{eyebrow}</p>
    <h3 class="mt-4 text-balance text-3xl font-[680] sm:text-4xl">{title}</h3>
    <p class="mt-4 max-w-lg leading-relaxed text-muted">{body}</p>
    {
      bullets.length > 0 && (
        <ul class="mt-5 space-y-2.5">
          {bullets.map((b) => (
            <li class="flex items-start gap-2.5 text-[0.94rem] text-ink/90">
              <svg class="mt-1 shrink-0" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#6C7CFF" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 6L9 17l-5-5" />
              </svg>
              {b}
            </li>
          ))}
        </ul>
      )
    }
    {
      linkHref && (
        <a href={linkHref} class="mt-6 inline-block text-[0.95rem] font-[600] text-iris underline-offset-4 transition-colors hover:text-accent hover:underline">
          {linkLabel ?? 'Learn more'} →
        </a>
      )
    }
  </div>
  <div class={`reveal reveal-delay-1 ${flip ? 'lg:order-1' : ''}`}>
    <div class="render-frame">
      <img src={image} alt={imageAlt} loading="lazy" decoding="async" width="1440" height="900" />
    </div>
  </div>
</div>
