---
import { links, framework } from '../data/downloads';
const year = new Date().getFullYear();
---

<footer class="mt-12 border-t border-hairline/60">
  <div class="mx-auto grid max-w-6xl gap-10 px-6 py-14 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <a href="/" class="flex items-center gap-2.5 font-[640]" style="font-family: var(--font-display);">
        <img src="/brand/logomark.svg" alt="" width="26" height="26" style="color:#8fa0ff" />
        <span>Elysium UI</span>
      </a>
      <p class="mt-3 max-w-[26ch] text-[0.85rem] leading-relaxed text-muted">
        Python desktop UI without the rectangles.
      </p>
    </div>
    <nav aria-label="Product">
      <h4 class="text-[0.8rem] font-[660] uppercase tracking-wider text-muted">Product</h4>
      <ul class="mt-3 space-y-2 text-[0.92rem]">
        <li><a class="text-ink/85 hover:text-ink" href="/download">Download</a></li>
        <li><a class="text-ink/85 hover:text-ink" href="/#features">Features</a></li>
        <li><a class="text-ink/85 hover:text-ink" href="/#designer">Designer</a></li>
        <li><a class="text-ink/85 hover:text-ink" href={framework.pypiUrl} rel="noopener">PyPI</a></li>
      </ul>
    </nav>
    <nav aria-label="Resources">
      <h4 class="text-[0.8rem] font-[660] uppercase tracking-wider text-muted">Resources</h4>
      <ul class="mt-3 space-y-2 text-[0.92rem]">
        <li><a class="text-ink/85 hover:text-ink" href={links.docs}>Framework docs</a></li>
        <li><a class="text-ink/85 hover:text-ink" href={links.designerDocs}>Designer docs</a></li>
        <li><a class="text-ink/85 hover:text-ink" href={links.tutorial}>Tutorial</a></li>
        <li><a class="text-ink/85 hover:text-ink" href={links.github} rel="noopener">GitHub</a></li>
      </ul>
    </nav>
    <nav aria-label="Legal">
      <h4 class="text-[0.8rem] font-[660] uppercase tracking-wider text-muted">Legal</h4>
      <ul class="mt-3 space-y-2 text-[0.92rem]">
        <li><a class="text-ink/85 hover:text-ink" href="/terms">Terms</a></li>
        <li><a class="text-ink/85 hover:text-ink" href="/privacy">Privacy</a></li>
        <li><a class="text-ink/85 hover:text-ink" href="/eula">Designer EULA</a></li>
        <li><a class="text-ink/85 hover:text-ink" href={`mailto:${links.supportEmail}`}>Support</a></li>
      </ul>
    </nav>
  </div>
  <div class="border-t border-hairline/40">
    <p class="mx-auto max-w-6xl px-6 py-6 text-[0.8rem] text-muted/80">
      © {year} Elysium UI. Framework code is Apache-2.0; the Elysium name and
      Blue Morpho logo are trademarks — see the brand policy. Elysium Designer is
      commercial software.
    </p>
  </div>
</footer>
