    ],
  },
  {
    h: '10. Support and Professional Services',
    blocks: [
      { p: 'Lamaute Labs may provide support through email, documentation, community channels, issue trackers, or other methods, but support is not guaranteed unless a separate written support agreement expressly says otherwise. Support availability, response times, fixes, workarounds, and outcomes are not guaranteed.' },
      { p: 'Any suggestions, examples, documentation, sample code, design guidance, or troubleshooting information are provided for convenience only. You remain responsible for deciding whether they are suitable for your environment, project, customer, and legal obligations.' },
      { p: 'Lamaute Labs may decline, limit, suspend, or terminate support for outdated versions, modified installations, unsupported platforms, suspected abuse, license violations, security risks, or issues caused by third-party software, hardware, networks, files, or services.' },
    ],
  },
  {
    h: '11. Files, Backups, Data Loss, and Output Responsibility',
    blocks: [
      { p: 'The Software may create, open, edit, export, import, or transform project files, .esk files, skins, themes, assets, settings, and related design files. You are solely responsible for backing up all files, testing exports, validating output, maintaining version control, retaining prior copies, and confirming that output works for your intended use.' },
      { p: 'Lamaute Labs is not responsible for lost, corrupted, overwritten, incompatible, inaccessible, deleted, misconfigured, failed, incomplete, inaccurate, or rejected files, projects, exports, builds, themes, skins, assets, designs, templates, or outputs.' },
      { p: 'You should not use the Software as the sole repository for important information. You should maintain independent backups and test recovery before relying on any output in production, customer, commercial, legal, regulated, or mission-critical environments.' },
    ],
  },
  {
    h: '12. Privacy, Telemetry, and Communications',
    blocks: [
      { p: 'The Software and related services may collect or process information described in the Elysium UI Privacy Policy, including information needed for website operation, support, license activation, subscription validation, fraud prevention, security, analytics, crash diagnostics, and communications.' },
