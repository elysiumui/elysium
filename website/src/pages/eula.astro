    h: '18. Indemnification',
    blocks: [
      { p: 'To the maximum extent permitted by law, you will defend, indemnify, and hold harmless Lamaute Labs and its owners, officers, directors, employees, contractors, agents, affiliates, licensors, service providers, payment processors, and suppliers from and against any claims, demands, losses, liabilities, damages, judgments, penalties, fines, costs, and expenses, including reasonable attorneys fees, arising out of or related to:' },
      {
        ul: [
          'your use or misuse of the Software;',
          'Your Work, including content, files, themes, skins, assets, exports, products, or services you create, publish, sell, license, or distribute;',
          'your violation of this EULA, law, third-party rights, third-party licenses, or third-party terms;',
          'your attempt to bypass license protection or security measures;',
          'your use of the Software in a prohibited, regulated, hazardous, high-risk, or unauthorized environment; or',
          'any claim that Your Work or your use of the Software infringes, misappropriates, or violates the rights of a third party.',
        ],
      },
    ],
  },
  {
    h: '19. Term and Termination',
    blocks: [
      { p: 'This EULA begins when you first download, install, activate, access, or use the Software and continues until terminated. Your license automatically ends when your trial expires, your subscription expires or is canceled, payment fails and is not cured, a chargeback is made, Lamaute Labs terminates your license, or you violate this EULA.' },
