      { p: 'If you provide support files, screenshots, logs, sample projects, crash dumps, or other materials to Lamaute Labs, you grant Lamaute Labs a non-exclusive right to use those materials to provide support, diagnose issues, improve the Software, investigate security or license issues, and maintain business records. Do not send confidential, regulated, sensitive, or third-party data unless it is necessary and you are authorized to do so.' },
    ],
  },
  {
    h: '13. Feedback',
    blocks: [
      { p: 'If you provide ideas, suggestions, feature requests, issue reports, improvements, comments, or other feedback about the Software, you grant Lamaute Labs a perpetual, worldwide, irrevocable, royalty-free, sublicensable license to use, copy, modify, distribute, commercialize, and otherwise exploit that feedback without restriction or compensation to you.' },
      { p: 'You agree that feedback is not confidential unless Lamaute Labs has signed a separate written confidentiality agreement covering that feedback.' },
    ],
  },
  {
    h: '14. Beta, Preview, Experimental, and Evaluation Features',
    blocks: [
      { p: 'The Software may include beta, preview, experimental, prerelease, evaluation, or unsupported features. Such features may be incomplete, unstable, insecure, inaccurate, incompatible, or changed or removed without notice.' },
