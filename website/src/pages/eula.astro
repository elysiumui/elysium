---
import Layout from '../layouts/Layout.astro';

/**
 * Elysium Designer End User License Agreement (Lamaute Labs LLC), from
 * Elysium Designer_EULA.docx — last updated July 3, 2026.
 */
type Block = { p?: string; ul?: string[] };
interface Section {
  h: string;
  blocks: Block[];
}

const summary: [string, string][] = [
  ['License model', 'Licensed, not sold. Personal, limited, non-exclusive, non-transferable, non-sublicensable, revocable license.'],
  ['Trial', 'Time-limited trial may include the full feature set. Continued use after the trial requires a paid license.'],
  ['Subscription pricing', 'As currently offered: $8/month or $79/year when prepaid annually, unless another price, promotion, enterprise order, or renewal term is shown at purchase.'],
  ['Activation', 'Use is enforced by a license key and may require periodic activation, validation, or subscription-status checks through PyLocket or other licensing services.'],
  ['Your work', 'You own the skins, themes, .esk files, exported assets, and other original content you create with the Software.'],
  ['Warranty and liability', 'The Software is provided AS IS, AS AVAILABLE, WITH ALL FAULTS, and without warranties. Lamaute Labs limits liability to the maximum extent permitted by law.'],
];

const sections: Section[] = [
  {
    h: '1. License Grant',
    blocks: [
      { p: 'Subject to your compliance with this EULA, payment of applicable fees, and maintenance of an active subscription or active trial, Lamaute Labs grants you a limited, personal, revocable, non-exclusive, non-transferable, non-sublicensable license to install and use the Software on desktop devices that you own or control solely for your internal business, professional, educational, or personal design purposes.' },
      { p: 'Unless an order form, enterprise agreement, or written approval from Lamaute Labs says otherwise, each license is for one named user. You may not share a license key, pool licenses, use one subscription for multiple unrelated users, or allow unlicensed users to access the Software.' },
      { p: 'The Software is licensed, not sold. You receive only the rights expressly granted in this EULA. Lamaute Labs and its licensors reserve all other rights.' },
    ],
  },
  {
    h: '2. Trial License',
    blocks: [
      { p: 'If Lamaute Labs offers a trial, the trial is provided for evaluation only and may be time-limited, feature-limited, device-limited, or otherwise restricted. Lamaute Labs may modify, suspend, or discontinue trials at any time.' },
      { p: 'When a trial ends, you must purchase and activate a paid license to continue using the Software. The Software may disable editing, exporting, saving, or other functions when a trial expires.' },
      { p: 'Trial access is provided AS IS and without any promise that the trial will continue, be converted to a paid subscription, or preserve any trial-generated files or settings.' },
    ],
  },
  {
    h: '3. Subscriptions, Fees, Taxes, and Renewals',
    blocks: [
      { p: 'Paid access requires an active subscription or another paid entitlement accepted by Lamaute Labs. Current standard pricing is $8 per month or $79 per year when prepaid annually, but prices, offers, taxes, renewal terms, and billing cycles may vary by purchase page, promotion, jurisdiction, currency, app channel, reseller, or written order.' },
      { p: 'Subscriptions continue for the period purchased and may renew automatically if the purchase flow, payment processor, or account settings provide for automatic renewal. You are responsible for reviewing the checkout page and subscription-management page before purchase.' },
      { p: 'Taxes, payment-card charges, foreign exchange charges, bank charges, and similar amounts are your responsibility unless checkout states otherwise. Lamaute Labs may rely on PyLocket, Stripe, Paddle, app stores, resellers, or other third parties to process payments, subscriptions, invoices, tax calculations, refunds, fraud review, and license delivery.' },
      { p: 'Except as required by law or expressly stated at purchase, fees are non-refundable. Failure to pay, payment reversal, chargeback, suspected fraud, or violation of this EULA may result in suspension or termination of the license key and access to the Software.' },
    ],
  },
  {
    h: '4. License Keys, Activation, and Validation',
    blocks: [
      { p: 'The Software may require a license key, account sign-in, online activation, device authorization, subscription-status check, or periodic validation. You authorize the Software and our licensing providers to transmit and receive information reasonably necessary to verify license status, prevent fraud, enforce subscription terms, provide updates, and secure the Software.' },
      { p: 'Activation and validation may use information such as license key, subscription status, device identifiers, operating system, app version, installation identifier, IP address, timestamps, error reports, entitlement records, and similar technical information. Use of that information is described in the Elysium UI Privacy Policy and any applicable PyLocket or payment-provider policies.' },
      { p: 'You may not bypass, disable, misrepresent, tamper with, remove, or interfere with license activation, validation, telemetry used for licensing, anti-tamper protections, update checks, or other technical protection measures. We may disable, revoke, or refuse a license key that is lost, leaked, resold, duplicated, abused, fraudulently obtained, or used in violation of this EULA.' },
    ],
  },
  {
    h: '5. Ownership of Your Work',
    blocks: [
      { p: 'As between you and Lamaute Labs, you own your original skins, themes, .esk files, configuration files, project files, exported images, exported assets, and other original materials that you create using the Software (collectively, "Your Work"). You may use Your Work for commercial or non-commercial purposes.' },
      { p: 'This EULA does not transfer to Lamaute Labs ownership of Your Work. You are solely responsible for Your Work, including its legality, accuracy, quality, suitability, non-infringement, licensing status, security, backups, publication, and downstream use.' },
      { p: 'Your ownership of Your Work does not give you ownership of the Software, the Elysium UI framework, sample assets owned by Lamaute Labs or third parties, trademarks, logos, trade dress, documentation, or other Lamaute Labs intellectual property.' },
    ],
  },
  {
    h: '6. Lamaute Labs Intellectual Property',
    blocks: [
      { p: 'The Software, documentation, user interface, source code, object code, executable code, installers, designs, workflows, templates supplied by us, sample files supplied by us, APIs supplied by us, trademarks, service marks, trade names, logos, Blue Morpho logo, Elysium name, and all related intellectual property are owned by Lamaute Labs or its licensors and are protected by copyright, trademark, trade secret, contract, and other laws.' },
      { p: 'You may not remove, obscure, or alter any copyright notice, trademark notice, attribution, license notice, digital signature, or other proprietary notice in or associated with the Software.' },
      { p: 'No rights are granted to use the Elysium name, Lamaute Labs name, Blue Morpho logo, or other marks in a way that suggests endorsement, sponsorship, affiliation, or official status without written permission from Lamaute Labs.' },
    ],
  },
  {
    h: '7. Restrictions',
    blocks: [
      { p: 'You agree that you will not, and will not allow anyone else to:' },
      {
        ul: [
          'copy, reproduce, distribute, publish, rent, lease, lend, sell, resell, sublicense, host, outsource, timeshare, provide as a service bureau, or otherwise make the Software available to any third party except as expressly permitted by this EULA;',
          'reverse engineer, decompile, disassemble, decrypt, inspect, modify, translate, adapt, derive source code from, or create derivative works of the Software, except to the limited extent applicable law expressly prohibits this restriction;',
          'bypass, disable, defeat, tamper with, or circumvent license checks, technical protection measures, usage limits, update mechanisms, anti-tamper logic, activation services, digital signatures, or security features;',
          'use the Software with any cracked, stolen, leaked, generated, shared, fraudulent, expired, or unauthorized license key;',
          'use bots, scripts, virtualized farms, automated installations, or other techniques to exceed licensed use, evade license enforcement, or simulate multiple authorized users;',
          'benchmark, publish performance comparisons, vulnerability details, or compatibility claims in a misleading way or in a way that harms the security of the Software or users;',
          'use the Software to infringe intellectual property rights, violate law, distribute malware, create deceptive content, misrepresent affiliation with Lamaute Labs, or violate any third-party terms;',
          'use the Software to develop or improve a competing designer application, licensing-circumvention tool, reverse-engineering tool, or service that substitutes for the Software;',
          'export, re-export, transfer, access, or use the Software in violation of export-control, sanctions, or anti-boycott laws; or',
          'use the Software in any high-risk use described in Section 15.',
        ],
      },
    ],
  },
  {
    h: '8. Third-Party and Open-Source Components',
    blocks: [
      { p: 'The Software may include, link to, install with, depend on, or interoperate with third-party libraries, open-source components, frameworks, package managers, operating-system features, fonts, templates, icons, examples, payment systems, license-management systems, and other third-party materials. Those materials may be governed by separate license terms, notices, privacy policies, or service terms.' },
      { p: 'To the extent a third-party or open-source license gives you rights that are broader than this EULA for that component, that component license governs only that component. This EULA continues to govern the proprietary portions of the Software and your use of Elysium Designer as a whole.' },
