    ],
  },
  {
    h: '20. Export Controls, Sanctions, and Anti-Corruption',
    blocks: [
      { p: 'You must comply with all applicable export-control, sanctions, anti-boycott, anti-money-laundering, and anti-corruption laws, including laws administered by the United States and any other jurisdiction that applies to you or your use of the Software.' },
      { p: 'You may not download, export, re-export, transfer, provide, or use the Software in any country, region, or territory subject to applicable embargoes or sanctions, or by or for any person or entity subject to applicable restricted-party, denied-party, blocked-party, or sanctions lists.' },
      { p: 'You represent that you are not located in, organized under the laws of, ordinarily resident in, or acting on behalf of any country, region, person, entity, or end use prohibited by applicable law. You are responsible for obtaining any required government authorization before exporting or transferring the Software or related technology.' },
    ],
  },
  {
    h: '21. U.S. Government Rights',
    blocks: [
