      { p: 'Before filing a legal claim, you agree to contact Lamaute Labs at support@elysiumui.com and attempt in good faith to resolve the dispute informally for at least 30 days, unless emergency injunctive relief is reasonably necessary.' },
    ],
  },
  {
    h: '24. General Terms',
    blocks: [
      { p: 'Severability. If any provision of this EULA is held invalid or unenforceable, that provision will be enforced to the maximum extent permitted by law, and the remaining provisions will remain in full force and effect.' },
