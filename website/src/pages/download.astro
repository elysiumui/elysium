---
import Layout from '../layouts/Layout.astro';
import { framework, designer, links } from '../data/downloads';

const osIcons: Record<string, string> = {
  apple:
    'M17.05 12.54c-.03-2.89 2.36-4.28 2.47-4.35-1.35-1.97-3.44-2.24-4.18-2.27-1.78-.18-3.47 1.05-4.37 1.05-.9 0-2.29-1.02-3.77-1-1.94.03-3.72 1.13-4.72 2.86-2.01 3.49-.51 8.66 1.45 11.5.96 1.39 2.1 2.95 3.6 2.89 1.44-.06 1.99-.93 3.73-.93s2.23.93 3.76.9c1.55-.03 2.53-1.41 3.48-2.81 1.09-1.61 1.54-3.17 1.57-3.25-.03-.02-3-1.15-3.02-4.59zM14.16 4.06c.8-.96 1.33-2.3 1.18-3.64-1.14.05-2.53.76-3.35 1.72-.73.85-1.38 2.21-1.21 3.52 1.28.1 2.58-.65 3.38-1.6z',
  windows: 'M3 5.6 10.4 4.5v7H3V5.6zm0 12.8 7.4 1.1v-6.9H3v5.8zM11.2 4.4 21 3v8.5h-9.8V4.4zm0 15.2L21 21v-8.5h-9.8v7.1z',
  linux:
    'M12 2c-1.9 0-3.2 1.5-3.2 3.6 0 1.2.1 2.2-.5 3.4-.8 1.5-2.4 3-2.9 5.2-.4 1.7 0 3.3 1 4.3.3-.7 1-1.2 1.7-1.3-.5-.7-.8-1.7-.6-2.8h.1c.2 1.5 1.2 2.7 2.2 3.3.8.5 2 .8 2.9.4.9.4 2.1.1 2.9-.4 1-.6 2-1.8 2.2-3.3h.1c.2 1.1-.1 2.1-.6 2.8.7.1 1.4.6 1.7 1.3 1-1 1.4-2.6 1-4.3-.5-2.2-2.1-3.7-2.9-5.2-.6-1.2-.5-2.2-.5-3.4C15.2 3.5 13.9 2 12 2z',
};
---

<Layout
  title="Download — Elysium UI & Elysium Designer"
  description="Get the free open-source Elysium UI framework from PyPI, or download the Elysium Designer free trial for macOS, Windows, and Linux."
>
  <main class="mx-auto max-w-6xl px-6 pt-40 pb-24">
    <p class="eyebrow">Download</p>
    <h1 class="mt-4 text-balance text-4xl font-[700] sm:text-5xl">
      Get <span class="text-iridescent">Elysium</span>
    </h1>

    <!-- Track A — framework -->
    <section class="glass mt-12 p-8 sm:p-10" aria-labelledby="fw-h">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h2 id="fw-h" class="text-2xl font-[660]">Elysium UI Framework</h2>
        <span class="rounded-full border border-success/40 bg-success/10 px-3 py-1 text-[0.78rem] font-[640] text-success">
          Free · open source · Apache-2.0
        </span>
      </div>
      <p class="mt-3 max-w-2xl text-[0.95rem] leading-relaxed text-muted">
        Python ≥ 3.10 on macOS (Apple Silicon &amp; Intel), Windows x64, and Linux
        x86_64. One package, every platform — the native engine ships inside the
        wheel. Free for commercial use.
      </p>
      <div class="mt-6 flex flex-wrap items-center gap-4">
        <button class="copy-chip text-base" data-copy={framework.pipCommand} type="button" aria-label={`Copy ${framework.pipCommand}`}>
          <span class="prompt">$</span>
          <span>{framework.pipCommand}</span>
        </button>
        <span class="tnum text-[0.85rem] text-muted" id="fw-version">v{framework.version}</span>
      </div>
      <p class="mt-4 text-[0.85rem] text-muted/90">
        Package is <code>elysium-ui</code>; you still <code>import elysium</code>.
        Wheels + source on
        <a class="font-[600] text-iris hover:underline" href={framework.pypiUrl} rel="noopener">PyPI</a> and
        <a class="font-[600] text-iris hover:underline" href={`${framework.repoUrl}/releases`} rel="noopener">GitHub Releases</a>.
        New here? Start with the
        <a class="font-[600] text-iris hover:underline" href={links.tutorial}>end-to-end tutorial</a>.
      </p>
    </section>

    <!-- Track B — Designer -->
    <section id="designer" class="glass mt-8 p-8 sm:p-10" style="border-color: rgba(108,124,255,.3);" aria-labelledby="ds-h">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h2 id="ds-h" class="text-2xl font-[660]">Elysium Designer</h2>
        <span class="rounded-full border border-iris/40 bg-iris/10 px-3 py-1 text-[0.78rem] font-[640] text-iris">
          {designer.trialDays}-day free trial · then a paid license
        </span>
      </div>
      <p class="mt-3 max-w-2xl text-[0.95rem] leading-relaxed text-muted">
        The visual authoring studio. Download the trial for your platform — every
        feature unlocked for {designer.trialDays} days, no card required. Licensing
        and secure delivery are handled by PyLocket.
      </p>

      <div class="mt-7 grid gap-4 sm:grid-cols-2 lg:grid-cols-4" id="designer-builds">
        {
          designer.builds.map((b) => (
            <a
              href={designer.trialUrl}
              data-os={b.os}
              class="glass glass-hover flex flex-col items-start gap-2 p-5"
              rel="noopener"
            >
              <svg width="22" height="22" viewBox="0 0 24 24" fill="#aeb9ff" aria-hidden="true">
                <path d={osIcons[b.icon]} />
              </svg>
              <span class="font-[640]">{b.label}</span>
              <span class="text-[0.82rem] text-muted">{b.arch}</span>
              <span class="mt-1 text-[0.85rem] font-[620] text-iris">Start free trial ↓</span>
            </a>
          ))
        }
      </div>
      <p class="mt-3 text-[0.82rem] text-muted/80">
        One trial covers every platform — enter your email and pick your OS on
        the next page.
      </p>

      <div class="mt-7 flex flex-wrap items-center gap-4">
        {
          designer.buyUrl ? (
            <a href={designer.buyUrl} class="btn-primary text-[0.95rem]" rel="noopener">Buy a license</a>
          ) : (
            <span class="btn-ghost cursor-default text-[0.95rem] opacity-80">Purchasing coming soon</span>
          )
        }
        <span class="tnum text-[0.95rem]"><span class="font-[680]">${designer.priceMonthly}/mo</span>
          <span class="text-muted">or</span>
          <span class="font-[680]">${designer.priceYearly}/yr</span>
          <span class="text-muted">prepaid annually</span></span>
        <a href="/eula" class="text-[0.9rem] text-muted underline underline-offset-4 hover:text-ink">Designer EULA</a>
      </div>

      <!-- Trial vs licensed -->
      <div class="mt-9 overflow-x-auto">
        <table class="w-full min-w-[480px] border-collapse text-left text-[0.92rem]">
          <thead>
            <tr class="border-b border-hairline text-muted">
              <th class="py-2.5 pr-4 font-[600]">What you get</th>
              <th class="py-2.5 pr-4 font-[600]">Free trial</th>
              <th class="py-2.5 font-[600]">Licensed</th>
            </tr>
          </thead>
          <tbody class="[&_td]:py-2.5 [&_td]:pr-4 [&_tr]:border-b [&_tr]:border-hairline/50">
            <tr><td>Full Designer feature set</td><td>✓ ({designer.trialDays} days)</td><td>✓</td></tr>
            <tr><td>Theme, skin &amp; animation authoring</td><td>✓</td><td>✓</td></tr>
            <tr><td>Export &amp; ship .esk skins</td><td>✓</td><td>✓</td></tr>
            <tr><td>Use beyond the trial period</td><td>—</td><td>✓</td></tr>
            <tr><td>Updates &amp; support</td><td>trial only</td><td>✓</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <p class="mt-10 text-[0.85rem] text-muted/80">
      Questions or trouble downloading? <a class="text-iris hover:underline" href={`mailto:${links.supportEmail}`}>{links.supportEmail}</a>
    </p>
  </main>
</Layout>

<script>
  // Copy chips (same behaviour as the hero).
  document.querySelectorAll<HTMLButtonElement>('.copy-chip[data-copy]').forEach((chip) => {
    chip.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(chip.dataset.copy ?? '');
        const prev = chip.innerHTML;
        chip.innerHTML = '<span class="copied">✓ copied</span>';
        setTimeout(() => (chip.innerHTML = prev), 1400);
      } catch {}
    });
  });

  // Highlight the visitor's platform card.
  const ua = navigator.userAgent;
  const os: string | null = /Mac/i.test(ua)
    ? /arm|Apple/i.test((navigator as any).userAgentData?.platform ?? '') || true
      ? 'mac-arm' // Apple Silicon is the default recommendation on macOS
      : 'mac-intel'
    : /Win/i.test(ua)
      ? 'windows'
      : /Linux/i.test(ua)
        ? 'linux'
        : null;
  if (os) {
    const card = document.querySelector<HTMLAnchorElement>(`#designer-builds [data-os="${os}"]`);
    if (card) {
      card.style.borderColor = 'rgba(108,124,255,.55)';
      card.style.boxShadow = '0 0 34px rgba(108,124,255,.16)';
      const tag = document.createElement('span');
      tag.textContent = 'Detected';
      tag.className = 'text-[0.7rem] font-[640] uppercase tracking-wider';
      tag.style.color = '#8fa0ff';
      card.prepend(tag);
    }
  }

  // Live framework version from PyPI (graceful fallback to the static label).
  fetch('https://pypi.org/pypi/elysium-ui/json')
    .then((r) => (r.ok ? r.json() : null))
    .then((j) => {
      const el = document.getElementById('fw-version');
      if (el && j?.info?.version) el.textContent = `v${j.info.version}`;
    })
    .catch(() => {});
</script>
