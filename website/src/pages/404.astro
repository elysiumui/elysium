---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 — Elysium UI">
  <main class="flex min-h-[70vh] flex-col items-center justify-center px-6 pt-32 text-center">
    <img src="/brand/logomark-color.svg" alt="" width="72" height="72" class="opacity-90" />
    <h1 class="mt-6 text-5xl font-[720]"><span class="text-iridescent">404</span></h1>
    <p class="mt-3 max-w-sm text-muted">
      This page fluttered off. Try the home page or the docs.
    </p>
    <div class="mt-8 flex gap-3">
      <a href="/" class="btn-primary text-[0.92rem]">Back home</a>
      <a href="https://docs.elysiumui.com" class="btn-ghost text-[0.92rem]">Docs</a>
    </div>
  </main>
</Layout>
