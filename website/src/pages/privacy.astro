<Layout title="Privacy Policy — Elysium UI">
  <main class="mx-auto max-w-3xl px-6 pt-40 pb-24">
    <p class="eyebrow">Lamaute Labs LLC</p>
    <h1 class="mt-3 text-3xl font-[700]">Privacy Policy</h1>
    <p class="mt-1 text-[0.95rem] text-muted">Elysium UI Framework, Elysium Designer, elysiumui.com</p>
    <p class="mt-2 text-[0.85rem] text-muted">Last updated: July 3, 2026 · Under counsel review.</p>

