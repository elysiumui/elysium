<Layout title="Terms of Service — Elysium UI">
  <main class="mx-auto max-w-3xl px-6 pt-40 pb-24">
    <p class="eyebrow">Lamaute Labs LLC</p>
    <h1 class="mt-3 text-3xl font-[700]">Elysium UI Terms of Service</h1>
    <p class="mt-2 text-[0.85rem] text-muted">Last updated July 3, 2026 · Working draft under legal review.</p>

    <div class="mt-8 space-y-6 text-[0.95rem] leading-relaxed text-ink/90">
      {
        sections.map((s) => (
          <>
            <h2 class="text-xl font-[650]">{s.h}</h2>
            {s.blocks.map((b) => (
              <>
                {b.p && <p>{b.p}</p>}
                {b.ul && (
                  <ul class="list-disc space-y-1 pl-6">
                    {b.ul.map((li) => (
                      <li>{li}</li>
                    ))}
                  </ul>
                )}
              </>
            ))}
          </>
        ))
      }

      <h2 class="text-xl font-[650]">30. Contact</h2>
      <p>Questions about these Terms may be sent to:</p>
