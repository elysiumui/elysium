---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Terms of Service — Elysium UI">
  <main class="prose-legal mx-auto max-w-3xl px-6 pt-40 pb-24">
    <h1 class="text-3xl font-[700]">Terms of Service</h1>
    <p class="mt-2 text-[0.85rem] text-muted">Draft — pending legal review. Last updated July 2026.</p>

    <div class="mt-8 space-y-6 text-[0.95rem] leading-relaxed text-ink/90">
      <p>
        These terms govern your use of elysiumui.com and the software distributed
        from it. By using the site you agree to them.
      </p>
      <h2 class="text-xl font-[650]">The framework</h2>
      <p>
        The Elysium UI framework is open-source software licensed under the
        Apache License 2.0. Your use of the framework is governed by that
        license, not these terms. The "Elysium" name and the Blue Morpho logo are
        trademarks; see the brand policy in the repository.
      </p>
      <h2 class="text-xl font-[650]">Elysium Designer</h2>
      <p>
        Elysium Designer is commercial software provided under its
        <a class="text-iris hover:underline" href="/eula">End User License Agreement</a>.
        Trials are time-limited; licenses are personal and non-transferable
        unless stated otherwise at purchase. Purchases and license delivery are
        processed by PyLocket.
      </p>
